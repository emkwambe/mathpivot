+          <Link href="/get-started" className="text-blue-700 hover:underline">
+            talk to a coach first
+          </Link>
+          .
+        </div>
+
+        <div className="mt-6 max-w-lg mx-auto">
+          <p className="text-xs text-slate-400 text-center leading-relaxed">
