# MathPivot TutorOS Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Public Supabase URL (safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (safe to expose to client)
# Found in: Supabase Dashboard > Settings > API > Project API Keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (KEEP SECRET - never expose to client)
# Found in: Supabase Dashboard > Settings > API > Project API Keys > service_role secret
# Required for admin operations:
#   - Creating users
#   - Bypassing Row Level Security (RLS)
#   - Processing webhooks
#   - Background jobs
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Base URL of the application (used for generating links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# AI SERVICES (Optional - for AI Tutor feature)
# =============================================================================

# Claude API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (from ai.google.dev)
GOOGLE_GENERATIVE_AI_API_KEY=...

# =============================================================================
# PAYMENT PROCESSING (Optional - for credit purchases)
# =============================================================================

# Stripe Secret Key (from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Publishable Key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret (for handling payment events)
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================

# Resend API Key (from resend.com)
RESEND_API_KEY=re_...

# From email address for notifications
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# VIDEO CONFERENCING (Optional)
# =============================================================================

# Zoom OAuth credentials (for generating meeting links)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Create a Supabase project at https://supabase.com
# 2. Copy your project URL and API keys from Settings > API
# 3. Run database migrations: npx supabase db push
# 4. Copy this file to .env.local and fill in values
# 5. Start the dev server: npm run dev
#
# For production:
# - Set environment variables in your hosting provider
# - Use production Stripe keys
# - Configure proper email sender
# - Set up Zoom OAuth app for video links
#
