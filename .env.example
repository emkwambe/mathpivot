# MathPivot TutorOS - Environment Configuration Template
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# =============================================================================

# Project URL (from Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://qpoiufyjancwijjkiaui.supabase.co

# Anonymous Key (from Project Settings > API > Project API Keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key (from Project Settings > API > Project API Keys > service_role secret)
# WARNING: Keep this secret! Never expose in client-side code
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# AI SERVICES (Optional - for AI Tutor feature)
# =============================================================================

# Claude API Key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini API Key (from https://ai.google.dev)
GOOGLE_GENERATIVE_AI_API_KEY=

# =============================================================================
# PAYMENT PROCESSING (Optional - for credit purchases)
# Get these from: https://dashboard.stripe.com/apikeys
# =============================================================================

# Stripe Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=

# Stripe Publishable Key (starts with pk_test_ or pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Webhook Secret (starts with whsec_)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# GOOGLE INTEGRATIONS (Optional - for calendar sync)
# Get these from: https://console.cloud.google.com/apis/credentials
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# ERROR MONITORING (Optional - for Sentry error tracking)
# Get these from: https://sentry.io/settings/
# =============================================================================

# Sentry DSN (from Project Settings > Client Keys > DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry org slug (for source map uploads in CI)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =============================================================================
# EMAIL (Optional - for transactional emails)
# Get from: https://resend.com/api-keys
# =============================================================================

RESEND_API_KEY=
