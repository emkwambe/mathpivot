From 456f9a08e431a7d069806567fbf97f5be6e383d2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 12:23:09 +0000
Subject: [PATCH] fix(00049): rename enum to program_subscription_status

The generic name 'subscription_status' collides with a pre-existing
enum from migration 00016 (service tiers, values active/past_due/
canceled/paused/trialing). The DO block catches the type creation
duplicate, but the pre-existing enum lacks 'incomplete', 'unpaid',
and 'incomplete_expired' so the column default failed at migration
time with 'invalid input value for enum subscription_status:
"incomplete"'.

Renaming the new enum to program_subscription_status avoids the
collision and covers the full Stripe subscription lifecycle.
---
 supabase/migrations/00049_program_subscriptions.sql | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/supabase/migrations/00049_program_subscriptions.sql b/supabase/migrations/00049_program_subscriptions.sql
index 9ad2058..abb78c8 100644
--- a/supabase/migrations/00049_program_subscriptions.sql
+++ b/supabase/migrations/00049_program_subscriptions.sql
@@ -7,7 +7,7 @@ DO $$ BEGIN
 EXCEPTION WHEN duplicate_object THEN NULL; END $$;
 
 DO $$ BEGIN
-  CREATE TYPE subscription_status AS ENUM (
+  CREATE TYPE program_subscription_status AS ENUM (
     'incomplete', 'incomplete_expired', 'trialing', 'active',
     'past_due', 'canceled', 'unpaid', 'paused'
   );
@@ -34,7 +34,7 @@ CREATE TABLE IF NOT EXISTS public.program_subscriptions (
   stripe_subscription_id TEXT UNIQUE NOT NULL,
   stripe_price_id TEXT NOT NULL,
   stripe_checkout_session_id TEXT,
-  status subscription_status NOT NULL DEFAULT 'incomplete',
+  status program_subscription_status NOT NULL DEFAULT 'incomplete',
 
   current_period_start TIMESTAMPTZ,
   current_period_end TIMESTAMPTZ,
-- 
2.43.0

